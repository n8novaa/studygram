# Copy to .env and adjust for local development.
# Never commit .env to version control.

# Required when DJANGO_DEBUG=False. Generate a private key for your environment.
DJANGO_SECRET_KEY=replace-with-a-private-development-key

# Set to False in production
DJANGO_DEBUG=True

# Production HTTPS settings default to secure values when DEBUG=False.
# Override SECURE_SSL_REDIRECT=False only when your trusted hosting proxy
# enforces HTTPS and sets Django's request security state correctly.
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# Enable HSTS preload only after confirming every subdomain supports HTTPS.
# SECURE_HSTS_PRELOAD=False

# Comma-separated hostnames
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Optional — omit to use SQLite for local development
# DATABASE_URL=postgres://user:password@localhost:5432/studygram

# Comma-separated origins allowed to call the API from the browser
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Password reset email. In DEBUG=True, Django prints reset emails in the console.
# To deliver to a real inbox locally, set EMAIL_BACKEND to
# django.core.mail.backends.smtp.EmailBackend and fill in the SMTP values below.
FRONTEND_URL=http://localhost:5173
EMAIL_BACKEND=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=StudyGram <noreply@studygram.local>
