# Copy to .env and adjust for local development.
# Never commit .env to version control.

# Required when DJANGO_DEBUG=False. Generate a private key for your environment.
DJANGO_SECRET_KEY=replace-with-a-private-development-key

# Set to False in production
DJANGO_DEBUG=True
DJANGO_LOG_LEVEL=INFO

# Production HTTPS settings default to secure values when DEBUG=False.
# Override SECURE_SSL_REDIRECT=False only when your trusted hosting proxy
# enforces HTTPS and sets Django's request security state correctly.
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# Enable HSTS preload only after confirming every subdomain supports HTTPS.
# SECURE_HSTS_PRELOAD=False

# Comma-separated hostnames
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Optional — omit to use SQLite for local development
# DATABASE_URL=postgres://user:password@localhost:5432/studygram

# Required for real-time broadcasts across multiple backend processes.
# Production settings require Redis and PostgreSQL.
# REDIS_URL=redis://localhost:6379/0

# Optional persistent upload location. In containers, mount a durable volume.
# DJANGO_MEDIA_ROOT=/var/lib/studygram/media
# Choose filesystem only when DJANGO_MEDIA_ROOT is a durable mounted volume.
# Use s3 for S3-compatible object storage (AWS credentials may come from IAM).
MEDIA_STORAGE_BACKEND=filesystem
# MEDIA_STORAGE_BACKEND=s3
# AWS_STORAGE_BUCKET_NAME=studygram-private-uploads
# AWS_S3_REGION_NAME=us-east-1
# AWS_S3_ENDPOINT_URL=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_ADDRESSING_STYLE=auto

# Comma-separated origins allowed to call the API from the browser
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Set these to the frontend origins when using Django session/CSRF-protected views.
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Enable only when requests reach Django through a trusted TLS-terminating proxy.
TRUST_PROXY_SSL_HEADER=False

# Password reset email. In DEBUG=True, Django prints reset emails in the console.
# To deliver to a real inbox locally, set EMAIL_BACKEND to
# django.core.mail.backends.smtp.EmailBackend and fill in the SMTP values below.
FRONTEND_URL=http://localhost:5173
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=StudyGram <noreply@studygram.local>
