# Copy to .env and adjust for local development.
# Never commit .env to version control.

# Required in production; optional locally (dev fallback exists in settings.py)
DJANGO_SECRET_KEY=change-me-to-a-random-secret-key

# Set to False in production
DJANGO_DEBUG=True

# Comma-separated hostnames
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Optional — omit to use SQLite for local development
# DATABASE_URL=postgres://user:password@localhost:5432/studygram

# Comma-separated origins for future React dev server
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
