FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app
COPY requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt

COPY backend /app/backend
WORKDIR /app/backend
RUN DJANGO_DEBUG=True \
    DJANGO_SECRET_KEY=build-only-not-a-runtime-secret \
    python manage.py collectstatic --noinput \
    && useradd --system --create-home --uid 10001 studygram \
    && mkdir -p /app/backend/media \
    && chown -R studygram:studygram /app/backend/staticfiles /app/backend/media

USER studygram
EXPOSE 8000
CMD ["daphne", "-b", "0.0.0.0", "-p", "8000", "config.asgi:application"]
