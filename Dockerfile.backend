FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PORT=10000

WORKDIR /app
COPY requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt

COPY backend /app/backend
WORKDIR /app/backend
RUN DJANGO_DEBUG=True \
    DJANGO_SECRET_KEY=build-only-not-a-runtime-secret \
    python manage.py collectstatic --noinput \
    && useradd --system --create-home --uid 10001 studygram \
    && mkdir -p /app/backend/media \
    && chown -R studygram:studygram /app/backend/staticfiles /app/backend/media

USER studygram
EXPOSE 10000
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
  CMD python -c "import os, urllib.request; urllib.request.urlopen('http://127.0.0.1:%s/api/health/' % os.environ.get('PORT', '10000'), timeout=3)" || exit 1
CMD ["sh", "-c", "exec daphne -b 0.0.0.0 -p ${PORT:-10000} config.asgi:application"]
